<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Cuidadores - ConnectSafe</title>

  <style>
    body {
      font-family: Arial;
      background: #A7D7C5;
      margin: 0;
      padding: 0;
    }

    .navbar {
      background: #64BE9C;
      padding: 15px;
      color: white;
      display: flex;
      justify-content: space-between;
    }

    .navbar a {
      font-size: 2rem;
      color: black;
      text-decoration: none;
      margin-right: 15px;
    }

    #cuidadores {
      text-decoration: underline;
    }

    .container {
      width: 90%;
      max-width: 900px;
      margin: 40px auto;
    }

    .card {
      background: #F6FBF9;
      padding: 20px;
      border-radius: 15px;
      margin-bottom: 20px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    button {
      background: #19A16E;
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background: #48e3aa;
    }
  </style>
</head>

<body>

  <div class="navbar">
    <div class="logo">
      <img src="../images/connectsafe.svg" alt="Connectsafe" srcset="">
    </div>
    <div>
      <a id="cuidadores" href="/caregivers">Cuidadores</a>
      <a href="/requests">Solicitações</a>
    </div>

    <div>
      {{ auth.user.email }}
      <img src="../images/user.svg" alt="Usuário" srcset="">
      <form method="POST" action="/logout" style="display:inline;">
        <button type="submit">Sair</button>
      </form>
    </div>
  </div>

  <div class="container">
    <h2>Lista de Cuidadores</h2>

    @each(caregiver in caregivers)

      <div class="card">
        <p><strong>Descrição:</strong> {{ caregiver.description }}</p>
        <p><strong>Nome:</strong> {{ caregiver.user.full_name }}</p>
        <p><strong>Nota:</strong> {{ caregiver.rating }}</p>

        <form method="POST" action="/requests">
          <input type="hidden" name="caregiver_id" value="{{ caregiver.id }}">
          <button type="submit">Solicitar Cuidador</button>
        </form>
      </div>

    @else

      <div class="card">
        <p>Nenhum cuidador disponível.</p>
      </div>

    @endeach

  </div>

</body>
</html>