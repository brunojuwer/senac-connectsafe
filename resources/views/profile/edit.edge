<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Editar - Usuário</title>

  <style>
     body {
      font-family: Arial;
      background: #A7D7C5;
      margin: 0;
      padding: 0;
    }

    .navbar {
      background: #64BE9C;
      padding: 15px;
      color: white;
      display: flex;
      justify-content: space-between;
    }

    .navbar a {
      font-size: 2rem;
      color: black;
      text-decoration: none;
      margin-right: 15px;
    }

    
.user-menu {
  position: relative;
  display: inline-block;
}

.user-button {
  display: flex;
  align-items: center;
  gap: 10px;

  cursor: pointer;
}

.user-button img {
  width: 40px;
  height: 40px;
}

.user-dropdown {
  display: none;

  position: absolute;
  right: 0;
  top: calc(100% + 10px);

  width: 180px;

  background: white;
  border-radius: 8px;

  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);

  padding: 8px;

  z-index: 1000;
}

.user-dropdown.active {
  display: block;
}

.user-dropdown a,
.user-dropdown button {
  display: block;

  width: 100%;

  border: none;
  background: transparent;

  color: #333;
  text-align: left;
  text-decoration: none;

  border-radius: 5px;
  cursor: pointer;
}

#editar-perfil {
    max-width: 151px;
    border: none;
    background: transparent;
    color: #333;
    text-align: left;
    text-decoration: none;
    border-radius: 5px;
    cursor: pointer;
    padding: 8px 14px;
    font-size: 13.33px;
}

#editar-perfil:hover {
  background: #f3f4f6;
}

.user-dropdown a:hover,
.user-dropdown button:hover {
  background: #f3f4f6;
}

  
    .container {
      width: 90%;
      max-width: 900px;
      margin: 40px auto;
    }

    .card {
      background: #F6FBF9;
      padding: 20px;
      border-radius: 15px;
      margin-bottom: 20px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .status {
      font-weight: bold;
    }

    .pending { color: orange; }
    .accepted { color: green; }
    .rejected { color: red; }

    button {
      padding: 8px 12px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-right: 5px;
    }

    .accept {
      background: #16a34a;
      color: white;
    }

    .reject {
      background: #dc2626;
      color: white;
    }
  </style>
</head>

<body>

  <div class="navbar">
    <div class="logo">
      <img src="/images/connectsafe.svg" alt="Connectsafe" srcset="">
    </div>
    <div>
      @if(auth.user.type !== 'CAREGIVER')
        <a href="/caregivers">Cuidadores</a>
      @endif
      <a id="solicitacoes" href="/requests">Solicitações</a>
    </div>


    <div class="user-menu">
      <div class="user-button">
        {{ auth.user.email }}
        <img src="/images/user.svg" alt="Usuário">
      </div>

      <div class="user-dropdown">
        <a id="editar-perfil" href="/profile/edit">Editar</a>

        <form method="POST" action="/logout">
          <button type="submit">Sair</button>
        </form>
        </div>
      </div>
  </div>

  <div class="container">
    <h2>Editar Perfil</h2>

   <form method="POST" action="/profile/update">

      <input
        type="text"
        name="full_name"
        value="{{ user.full_name }}"
        placeholder="Nome"
      >

      <input
        type="email"
        name="email"
        value="{{ user.email }}"
        placeholder="E-mail"
      >

      <input
        type="text"
        name="phone"
        value="{{ user.phone }}"
        placeholder="Telefone"
      >

      @if(user.type === 'CAREGIVER')

        <textarea
          name="description"
          placeholder="Descrição"
        >{{ profile.description }}</textarea>

      @endif

      <button type="submit">
        Salvar alterações
      </button>

    </form>

  </div>

  <script>
    const userButton = document.querySelector('.user-button');
    const userDropdown = document.querySelector('.user-dropdown');

    userButton.addEventListener('click', () => {
      userDropdown.classList.toggle('active');
    });

    document.addEventListener('click', (event) => {
      if (!event.target.closest('.user-menu')) {
        userDropdown.classList.remove('active');
      }
    });
  </script>
</body>
</html>